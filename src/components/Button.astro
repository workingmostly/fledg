---
interface Props {
  href: string;
  /** primary: ink pill · secondary: ink outline · light: paper pill for dark bands */
  variant?: 'primary' | 'secondary' | 'light';
  class?: string;
}

const { href, variant = 'primary', class: className } = Astro.props;
---
<a href={href} class:list={['btn', `btn--${variant}`, className]}><slot /></a>
