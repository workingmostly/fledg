---
import { links, type Section } from '../data/site';

interface Props {
  /** Highlights the matching nav link. */
  current?: Section;
  /** True on the section's index page (aria-current="page"), false on pages inside it. */
  exact?: boolean;
}

const { current, exact = true } = Astro.props;

const items: { label: string; href: string; section?: Section }[] = [
  { label: 'How it works', href: links.how },
  { label: 'Members', href: links.members, section: 'members' },
  { label: 'Principles', href: links.principles },
  { label: 'Where the money goes', href: links.money, section: 'money' },
  { label: 'FAQ', href: links.faq },
];
const join: (typeof items)[number] = { label: 'Join the collective', href: links.join };

const ariaCurrent = (section?: Section) =>
  section && section === current ? (exact ? 'page' : 'true') : undefined;
---
<header class="site-header" data-site-header>
  <div class="bar">
    <a href={links.home} aria-label="Fledg home" class="logo">fledg</a>

    <nav class="nav-wide" aria-label="Main">
      {items.map((item) => (
        <a href={item.href} aria-current={ariaCurrent(item.section)}>{item.label}</a>
      ))}
      <span class="sep" aria-hidden="true"></span>
      <a href={join.href}>{join.label}</a>
      <a href={links.members} class="nav-cta">Find a coach</a>
    </nav>

    <button type="button" class="menu-toggle" aria-expanded="false" aria-controls="site-menu" data-menu-toggle>
      <span class="bars" aria-hidden="true"><span></span><span></span></span>
      <span data-menu-label>Menu</span>
    </button>
  </div>

  <nav id="site-menu" class="nav-panel" aria-label="Main">
    {[...items, join].map((item) => (
      <a href={item.href} aria-current={ariaCurrent(item.section)}>{item.label}</a>
    ))}
    <a href={links.members} class="nav-panel-cta">Find a coach</a>
  </nav>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  const toggle = header?.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const label = header?.querySelector<HTMLElement>('[data-menu-label]');

  if (header && toggle && label) {
    const setOpen = (open: boolean) => {
      header.toggleAttribute('data-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      label.textContent = open ? 'Close' : 'Menu';
    };
    toggle.addEventListener('click', () => setOpen(!header.hasAttribute('data-open')));
    header.querySelectorAll('.nav-panel a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    // The menu only exists below 1100px; close it if the window grows past that.
    matchMedia('(min-width: 1100px)').addEventListener('change', (e) => e.matches && setOpen(false));
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 30;
    background: oklch(0.972 0.008 85 / 0.94);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--rule);
  }

  .bar {
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 var(--gutter);
    height: var(--header-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
  }

  .logo {
    color: var(--ink);
    text-decoration: none;
    font-family: var(--serif);
    font-size: 32px;
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1;
    padding-top: 2px;
  }

  .nav-wide {
    display: flex;
    align-items: center;
    gap: clamp(20px, 2.2vw, 32px);
    font-size: 15px;
  }
  .nav-wide a {
    color: var(--ink);
    text-decoration: none;
  }
  .nav-wide a:hover { color: var(--teal); }
  .nav-wide a[aria-current] {
    color: var(--teal);
    text-decoration: underline;
    text-underline-offset: 8px;
    text-decoration-thickness: 1.5px;
  }
  .sep {
    width: 1px;
    height: 22px;
    background: var(--rule);
  }
  .nav-wide .nav-cta {
    display: inline-flex;
    align-items: center;
    height: 42px;
    padding: 0 20px;
    border-radius: 999px;
    background: var(--duck-egg);
    color: var(--ink);
    font-weight: 500;
    transition: background-color var(--ease), color var(--ease);
  }
  .nav-wide .nav-cta:hover {
    background: var(--teal);
    color: var(--paper);
  }

  .menu-toggle {
    display: none;
    align-items: center;
    gap: 10px;
    height: 44px;
    padding: 0 18px;
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    background: transparent;
    color: var(--ink);
    font-family: var(--sans);
    font-size: 15px;
    font-weight: 500;
    line-height: normal;
    cursor: pointer;
  }
  .bars {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .bars span {
    display: block;
    width: 16px;
    height: 1.5px;
    background: currentColor;
  }

  .nav-panel {
    display: none;
    flex-direction: column;
    border-top: 1px solid var(--rule);
    padding: 4px var(--gutter) 28px;
    background: var(--paper);
  }
  .nav-panel a {
    padding: 16px 0;
    border-bottom: 1px solid var(--rule);
    font-family: var(--serif);
    font-size: 28px;
    line-height: 1.1;
    color: var(--ink);
    text-decoration: none;
  }
  .nav-panel a[aria-current] { color: var(--teal); }
  .nav-panel .nav-panel-cta {
    margin-top: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 52px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: var(--duck-egg);
    color: var(--ink);
    font-family: var(--sans);
    font-weight: 500;
    font-size: 16px;
    line-height: 1.5;
  }

  /* Narrow: collapse the nav into the Menu button. */
  @media (max-width: 1099.98px) {
    .nav-wide { display: none; }
    .menu-toggle { display: inline-flex; }
    .site-header[data-open] .nav-panel { display: flex; }
  }
</style>
