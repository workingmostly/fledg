---
/**
 * Find a coach: a few questions, suggested members, then sign up. Matching
 * runs in the browser. Signing up posts to /api/sign-up, which emails the
 * answers to Fledg and the chosen coach; nothing is stored. Results are the
 * same member cards as the Members page.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import MemberCard from '../components/MemberCard.astro';
import { links } from '../data/site';
import { getMembers, SPECIALISMS, GENDERS, NEEDS } from '../data/members';

const members = await getMembers();
const cities = [...new Set(members.map((m) => m.data.city))].sort();
---
<BaseLayout
  title="Find a coach · fledg"
  description="Answer a few questions about what you’d like to work on, and we’ll suggest a coach and the specialists who might help. Then sign up, and your coach will get in touch."
>
  <section class="container intro">
    <div class="eyebrow">Find a coach</div>
    <h1 class="h1 intro-h1">Tell us what you need. We’ll suggest who to work with.</h1>
    <p class="lead intro-lead">A few quick questions, then a coach to start with and the specialists they might bring in. Sign up, and your coach will get in touch about a free intro call. Nothing is sent until you do.</p>
  </section>

  <section class="container chooser">
    <form class="questions" data-chooser novalidate>
      <fieldset class="q">
        <legend>What would you like help with?</legend>
        <p class="q-hint">Choose as many as you like.</p>
        <div class="options">
          {NEEDS.map((n) => (
            <label class="option"><input type="checkbox" name="need" value={n.disciplines.join('|')} /><span>{n.label}</span></label>
          ))}
        </div>
        <p class="q-error" data-need-error hidden>Choose at least one thing you’d like help with.</p>
      </fieldset>

      <fieldset class="q">
        <legend>Does any of this apply to you?</legend>
        <p class="q-hint">Optional.</p>
        <div class="options">
          {SPECIALISMS.map((s) => (
            <label class="option"><input type="checkbox" name="specialism" value={s} /><span>{s}</span></label>
          ))}
        </div>
      </fieldset>

      <fieldset class="q">
        <legend>Where are you?</legend>
        <p class="q-hint">Members train people in person near them, and anywhere on video.</p>
        <select name="city" class="select">
          <option value="">Somewhere else, or video is fine</option>
          {cities.map((c) => <option value={c}>{c}</option>)}
        </select>
      </fieldset>

      <fieldset class="q">
        <legend>Would you like to work with someone of a particular gender?</legend>
        <div class="options">
          {GENDERS.map(([value, label]) => (
            <label class="option"><input type="radio" name="gender" value={value} checked={value === 'any'} /><span>{value === 'any' ? 'No preference' : label}</span></label>
          ))}
        </div>
      </fieldset>

      <label class="taking"><input type="checkbox" name="taking" checked /><span>Only suggest members taking new clients</span></label>

      <div class="submit-row">
        <button type="submit" class="btn btn--primary">Show my suggestions</button>
        <a href={links.members}>Or browse everyone</a>
      </div>
    </form>

    <noscript><p class="noscript">This page needs JavaScript to make suggestions. You can still <a href={links.members}>browse and filter every member</a>.</p></noscript>

    <div class="results" data-results hidden>
      <div class="results-head">
        <h2 class="h2 h2--sm" tabindex="-1" data-results-title>Your suggestions</h2>
        <button type="button" class="again" data-again>Start again</button>
      </div>

      <div class="group" data-group="coach">
        <h3 class="group-title">A coach to start with</h3>
        <p class="group-intro">Your coach is the person you talk to every week. They write your programme with you and bring in specialists when you need them.</p>
        <div class="picks" data-picks></div>
        <p class="none" data-none hidden>No coaches match all of that at the moment. Try fewer answers, or <a href={links.members}>browse everyone</a>.</p>
      </div>

      <div class="group" data-group="specialist">
        <h3 class="group-title">Specialists who could help too</h3>
        <p class="group-intro">Your coach can bring any of them in. You pay each member directly, and you’ll know the cost before you agree.</p>
        <div class="picks" data-picks></div>
        <p class="none" data-none hidden>No specialists match that at the moment. Your coach can still suggest someone.</p>
      </div>

      <form class="signup" data-signup novalidate>
        <div class="signup-head">
          <h3 class="group-title">Sign up</h3>
          <p class="group-intro">Choose who you’d like to start with. We’ll send them your answers, and copy in Fledg, so they can get in touch about a free intro call. Nothing is agreed until you both decide it’s a good fit.</p>
        </div>

        <fieldset class="q q--first">
          <legend>Who would you like to start with?</legend>
          <div class="options" data-coach-options></div>
        </fieldset>

        <div class="fields">
          <label class="field"><span>Your name</span><input name="name" autocomplete="name" required maxlength="120" /></label>
          <label class="field"><span>Email</span><input type="email" name="email" autocomplete="email" required maxlength="200" /></label>
          <label class="field"><span>Phone <em>optional</em></span><input type="tel" name="phone" autocomplete="tel" maxlength="40" /></label>
          <label class="field field--wide"><span>Anything you’d like them to know? <em>optional</em></span><textarea name="note" rows="4" maxlength="2000"></textarea></label>
          <div class="trap" aria-hidden="true"><label>Leave this empty <input name="website" tabindex="-1" autocomplete="off" /></label></div>
        </div>

        <p class="form-error" data-signup-error role="alert" hidden></p>
        <div class="submit-row">
          <button type="submit" class="btn btn--primary" data-signup-submit>Sign up</button>
        </div>
        <p class="small">Your details go by email to the coach you choose and to Fledg, and nowhere else. Nothing is stored on this website.</p>
      </form>

      <div class="done" data-signup-done tabindex="-1" hidden>
        <h3 class="group-title" data-done-title></h3>
        <p data-done-text></p>
        <p data-done-booking hidden><a class="btn btn--secondary" data-done-booking-link>Book an intro call now</a></p>
        <p class="ph-note" data-done-preview hidden></p>
      </div>
    </div>

    <div class="pool" data-pool hidden>
      {members.map((m) => <MemberCard member={m} />)}
    </div>
  </section>
</BaseLayout>

<script>
  type Card = {
    el: HTMLElement;
    name: string;
    city: string;
    role: string;
    discipline: string;
    specialisms: string[];
    gender: string;
    taking: boolean;
    id: string;
    booking?: string;
  };

  const form = document.querySelector<HTMLFormElement>('[data-chooser]');
  const results = document.querySelector<HTMLElement>('[data-results]');
  if (form && results) {
    const cards: Card[] = [...document.querySelectorAll<HTMLElement>('[data-pool] [data-member-card]')].map((el) => ({
      el,
      name: el.dataset.name!,
      city: el.dataset.city!,
      role: el.dataset.role!,
      discipline: el.dataset.discipline!,
      specialisms: el.dataset.specialisms!.split('|'),
      gender: el.dataset.gender!,
      taking: el.dataset.taking === 'true',
      id: el.dataset.id!,
      booking: el.dataset.booking,
    }));
    const needError = form.querySelector<HTMLElement>('[data-need-error]')!;
    const title = results.querySelector<HTMLElement>('[data-results-title]')!;
    const signup = results.querySelector<HTMLFormElement>('[data-signup]')!;
    const coachOptions = signup.querySelector<HTMLElement>('[data-coach-options]')!;
    const signupError = signup.querySelector<HTMLElement>('[data-signup-error]')!;
    const submitButton = signup.querySelector<HTMLButtonElement>('[data-signup-submit]')!;
    const done = results.querySelector<HTMLElement>('[data-signup-done]')!;
    const first = (name: string) => name.split(' ')[0];

    // What was asked and suggested, sent along with the sign-up.
    let answers = { needs: [] as string[], specialisms: [] as string[], city: '', gender: '' };
    let suggested: Card[] = [];

    const suggest = (role: string, disciplines: Set<string>, specialisms: string[], city: string, gender: string, takingOnly: boolean) =>
      cards
        .filter((c) => c.role === role)
        .filter((c) => gender === 'any' || c.gender === gender)
        .filter((c) => !takingOnly || c.taking)
        .map((c) => {
          const discipline = disciplines.has(c.discipline);
          const shared = c.specialisms.filter((s) => specialisms.includes(s));
          const local = city !== '' && c.city === city;
          const score = (discipline ? 3 : 0) + shared.length + (local ? 1 : 0);
          const why = [discipline && c.discipline, shared.length > 0 && `Works with ${shared.join(', ').toLowerCase()}`, local && `In ${c.city}`];
          return { c, score, why: why.filter(Boolean).join(' · ') };
        })
        .filter((r) => r.score > 0)
        .sort((a, b) => b.score - a.score || Number(b.c.taking) - Number(a.c.taking) || a.c.name.localeCompare(b.c.name))
        .slice(0, 3);

    const show = (group: string, picks: ReturnType<typeof suggest>) => {
      const box = results.querySelector<HTMLElement>(`[data-group="${group}"]`)!;
      const list = box.querySelector<HTMLElement>('[data-picks]')!;
      list.replaceChildren(
        ...picks.map(({ c, why }) => {
          const wrap = document.createElement('div');
          wrap.className = 'pick';
          const reason = document.createElement('p');
          reason.className = 'why';
          reason.textContent = why;
          wrap.append(reason, c.el.cloneNode(true));
          return wrap;
        }),
      );
      list.hidden = picks.length === 0;
      box.querySelector<HTMLElement>('[data-none]')!.hidden = picks.length > 0;
    };

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const needs = data.getAll('need') as string[];
      needError.hidden = needs.length > 0;
      if (!needs.length) {
        needError.scrollIntoView({ block: 'center' });
        return;
      }
      const disciplines = new Set(needs.flatMap((n) => n.split('|')));
      const specialisms = data.getAll('specialism') as string[];
      const city = String(data.get('city') ?? '');
      const gender = String(data.get('gender') ?? 'any');
      const takingOnly = data.get('taking') !== null;

      const coaches = suggest('coach', disciplines, specialisms, city, gender, takingOnly);
      const specialists = suggest('specialist', disciplines, specialisms, city, gender, takingOnly);
      show('coach', coaches);
      show('specialist', specialists);

      answers = {
        needs: [...form.querySelectorAll<HTMLInputElement>('input[name=need]:checked')].map((i) => i.nextElementSibling!.textContent!.trim()),
        specialisms,
        city,
        gender: gender === 'any' ? '' : form.querySelector<HTMLInputElement>('input[name=gender]:checked')!.nextElementSibling!.textContent!.trim(),
      };
      suggested = [...coaches, ...specialists].map((r) => r.c);
      const choices = [
        ...coaches.map(({ c }) => ({ value: c.id, label: c.name })),
        { value: '', label: 'I’m not sure yet' },
      ];
      coachOptions.replaceChildren(
        ...choices.map((choice, i) => {
          const label = document.createElement('label');
          label.className = 'option';
          const input = Object.assign(document.createElement('input'), { type: 'radio', name: 'coach', value: choice.value, checked: i === 0 });
          const span = document.createElement('span');
          span.textContent = choice.label;
          label.append(input, span);
          return label;
        }),
      );
      signup.hidden = false;
      done.hidden = true;
      signupError.hidden = true;
      results.hidden = false;
      title.focus({ preventScroll: true });
      title.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
    });

    const fail = (message: string) => {
      signupError.replaceChildren();
      signupError.append(message, ' ');
      const mail = Object.assign(document.createElement('a'), { href: 'mailto:hello@fledg.org', textContent: 'hello@fledg.org' });
      signupError.append('Or email ', mail, ' and we’ll help.');
      signupError.hidden = false;
    };

    signup.addEventListener('input', () => { signupError.hidden = true; });

    signup.addEventListener('submit', async (event) => {
      event.preventDefault();
      signupError.hidden = true;
      const nameInput = signup.querySelector<HTMLInputElement>('input[name=name]')!;
      const emailInput = signup.querySelector<HTMLInputElement>('input[name=email]')!;
      if (!nameInput.value.trim() || !emailInput.checkValidity() || !emailInput.value.trim()) {
        signupError.textContent = 'Please add your name and a working email address.';
        signupError.hidden = false;
        (nameInput.value.trim() ? emailInput : nameInput).focus();
        return;
      }
      const data = new FormData(signup);
      const coachId = String(data.get('coach') ?? '');
      const coach = cards.find((c) => c.id === coachId);
      const payload = {
        name: String(data.get('name')),
        email: String(data.get('email')),
        phone: String(data.get('phone') ?? ''),
        note: String(data.get('note') ?? ''),
        coach: coachId,
        answers,
        suggested: suggested.map((c) => c.id),
        website: String(data.get('website') ?? ''),
      };

      submitButton.disabled = true;
      submitButton.textContent = 'Sending…';
      let response: Response | undefined;
      try {
        response = await fetch('/api/sign-up', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
      } catch {
        // Network failure: handled below.
      }
      submitButton.disabled = false;
      submitButton.textContent = 'Sign up';
      const result = response ? await response.json().catch(() => ({})) : {};

      if (!response?.ok) {
        fail(response?.status === 400 ? 'Please check your name and email address.' : 'Sorry, that didn’t send.');
        return;
      }

      const name = first(payload.name.trim());
      done.querySelector('[data-done-title]')!.textContent = `Thanks, ${name}.`;
      done.querySelector('[data-done-text]')!.textContent = coach
        ? `We’ve sent your answers to ${first(coach.name)} and to Fledg. ${first(coach.name)} will be in touch about a free intro call.`
        : 'We’ve sent your answers to Fledg. Someone will reply with a coach who’d suit you.';
      const booking = done.querySelector<HTMLElement>('[data-done-booking]')!;
      booking.hidden = !coach?.booking;
      if (coach?.booking) booking.querySelector('a')!.href = coach.booking;
      const preview = done.querySelector<HTMLElement>('[data-done-preview]')!;
      preview.hidden = !result.dryRun;
      if (result.dryRun) {
        preview.textContent = `Preview: no email was sent. It would have gone to ${result.to.join(' and ')}${coach && !result.coachHasEmail ? ` (${coach.name} has no email address on file yet)` : ''}.`;
      }
      signup.hidden = true;
      signup.reset();
      done.hidden = false;
      done.focus();
    });

    results.querySelector('[data-again]')!.addEventListener('click', () => {
      form.reset();
      results.hidden = true;
      needError.hidden = true;
      form.scrollIntoView({ behavior: 'auto', block: 'start' });
    });
  }
</script>

<style>
  .intro {
    padding-block: clamp(40px, 5vw, 80px) clamp(32px, 4vw, 56px);
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .intro-h1 {
    max-width: 880px;
    font-size: clamp(44px, 5.6vw, 84px);
  }
  .intro-lead { max-width: 640px; }

  .chooser { padding-bottom: var(--section-pad); }
  .questions {
    max-width: 880px;
    border-top: 1px solid var(--ink);
  }
  .q {
    margin: 0;
    padding: 28px 0;
    border: 0;
    border-bottom: 1px solid var(--rule);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .q legend {
    float: left;
    width: 100%;
    padding: 0;
    font-family: var(--serif);
    font-size: clamp(23px, 2vw, 28px);
    line-height: 1.25;
    letter-spacing: -0.01em;
  }
  .q legend + * { clear: both; }
  .q-hint { margin: 0; font-size: 14px; color: var(--slate); }
  .q-error { margin: 0; font-size: 14px; font-weight: 500; color: var(--leave-red); }
  .q-error[hidden] { display: none; }
  .options {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  /* :global because the coach choices in the sign-up form are built by the script. */
  .options :global(.option) { position: relative; cursor: pointer; }
  .options :global(.option input) {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
  }
  .options :global(.option span) {
    display: inline-flex;
    align-items: center;
    height: 40px;
    padding: 0 16px;
    border-radius: 999px;
    border: 1px solid var(--rule);
    background: transparent;
    color: var(--ink);
    font-size: 15px;
    transition: background-color var(--ease), border-color var(--ease), color var(--ease);
  }
  .options :global(.option:hover span) { border-color: var(--ink); }
  .options :global(.option input:checked + span) {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }
  .options :global(.option input:focus-visible + span),
  .taking input:focus-visible,
  .select:focus-visible {
    outline: 2px solid var(--teal);
    outline-offset: 2px;
  }
  .select {
    align-self: flex-start;
    min-width: min(100%, 320px);
    height: 44px;
    padding: 0 14px;
    border: 1px solid var(--rule-strong);
    border-radius: 8px;
    background: var(--white);
    color: var(--ink);
    font: inherit;
    font-size: 15px;
  }
  .taking {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 22px 0;
    border-bottom: 1px solid var(--rule);
    font-size: 15px;
    cursor: pointer;
  }
  .taking input { width: 18px; height: 18px; accent-color: var(--teal); margin: 0; }
  .submit-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 24px;
    padding-top: 28px;
  }
  .submit-row .btn { border: 0; cursor: pointer; font-family: inherit; }
  .submit-row a { font-size: 15px; }
  .noscript {
    max-width: 880px;
    margin: 24px 0 0;
    font-size: 15px;
    color: var(--slate);
  }

  .results {
    margin-top: clamp(56px, 7vw, 96px);
    display: flex;
    flex-direction: column;
    gap: clamp(40px, 5vw, 64px);
  }
  .results[hidden] { display: none; }
  .results-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px 24px;
    flex-wrap: wrap;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--ink);
    scroll-margin-top: calc(var(--header-h) + 24px);
  }
  .results-head h2 { scroll-margin-top: calc(var(--header-h) + 24px); }
  .results-head h2:focus { outline: none; }
  .again {
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--teal);
    font-size: 15px;
    text-decoration: underline;
    text-underline-offset: 0.18em;
    cursor: pointer;
  }
  .again:hover { color: var(--ink); }
  .group {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .group-title {
    margin: 0;
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(26px, 2.2vw, 32px);
    line-height: 1.1;
    letter-spacing: -0.015em;
  }
  .group-intro {
    margin: 0 0 12px;
    max-width: 640px;
    font-size: 15px;
    line-height: 1.55;
    color: var(--slate);
  }
  .picks {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 250px), 1fr));
    gap: 48px 24px;
  }
  .picks[hidden], .none[hidden] { display: none; }
  .picks :global(.pick) {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .picks :global(.why) {
    margin: 0;
    padding: 6px 10px;
    border-radius: 6px;
    background: var(--teal-pale);
    color: var(--teal-ink);
    font-size: 13px;
    font-weight: 500;
    line-height: 1.4;
  }
  .none { margin: 0; font-size: 15px; color: var(--slate); }

  /* Sign up */
  .signup, .done {
    max-width: 880px;
    padding-top: 28px;
    border-top: 1px solid var(--ink);
  }
  .signup[hidden], .done[hidden] { display: none; }
  .signup-head { display: flex; flex-direction: column; gap: 12px; }
  .q--first { border-bottom: 0; padding-bottom: 24px; }
  .fields {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 18px 24px;
  }
  .field { display: flex; flex-direction: column; gap: 6px; font-size: 14px; font-weight: 500; }
  .field--wide { grid-column: 1 / -1; }
  .field em { font-style: normal; font-weight: 400; color: var(--slate); }
  .field input, .field textarea {
    width: 100%;
    padding: 12px 14px;
    border: 1px solid var(--rule-strong);
    border-radius: 8px;
    background: var(--white);
    color: var(--ink);
    font: inherit;
    font-size: 16px;
    font-weight: 400;
  }
  .field input { height: 46px; }
  .field textarea { resize: vertical; line-height: 1.5; }
  .field input:focus-visible, .field textarea:focus-visible { outline: 2px solid var(--teal); outline-offset: 2px; }
  .trap { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .form-error { margin: 18px 0 0; font-size: 15px; color: var(--leave-red); }
  .form-error[hidden] { display: none; }
  .small { margin: 14px 0 0; font-size: 13px; line-height: 1.5; color: var(--slate); }
  .submit-row .btn:disabled { opacity: 0.6; cursor: default; }
  .done { display: flex; flex-direction: column; gap: 12px; }
  .done:focus { outline: none; }
  .done p { margin: 0; font-size: 16px; line-height: 1.55; }
  .done p[hidden] { display: none; }
  .done .ph-note { color: var(--slate); }
</style>
