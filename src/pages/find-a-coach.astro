---
/**
 * Find a coach: a step-by-step form. One question at a time, then suggested
 * members, then sign up. Matching runs in the browser. Signing up posts to
 * /api/sign-up, which emails the answers to Fledg and the chosen coach;
 * nothing is stored. Results are the same member cards as the Members page.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import MemberCard from '../components/MemberCard.astro';
import { links } from '../data/site';
import { getMembers, SPECIALISMS, GENDERS, NEEDS } from '../data/members';

const members = await getMembers();
const cities = [...new Set(members.map((m) => m.data.city))].sort();
const TOTAL_STEPS = 6;
---
<BaseLayout
  title="Find a coach · fledg"
  description="Answer a few questions about what you’d like to work on, and we’ll suggest a coach and the specialists who might help. Then sign up, and your coach will get in touch."
>
  <section class="container intro">
    <div class="eyebrow">Find a coach</div>
    <h1 class="h1 intro-h1">Tell us what you need. We’ll suggest who to work with.</h1>
    <p class="lead intro-lead">A few quick questions, one at a time. Then choose a coach and sign up. Nothing is sent until you do.</p>
  </section>

  <section class="container wizard-wrap">
    <form class="wizard" data-wizard data-total={TOTAL_STEPS} novalidate>
      <div class="progress-row">
        <span class="step-count" data-step-count aria-live="polite">Step 1 of {TOTAL_STEPS}</span>
        <span class="progress" aria-hidden="true"><span data-progress style={`width:${100 / TOTAL_STEPS}%`}></span></span>
      </div>

      <fieldset class="step" data-step="1">
        <legend class="step-title" tabindex="-1">What would you like help with?</legend>
        <p class="step-hint">Choose as many as you like.</p>
        <div class="options">
          {NEEDS.map((n) => (
            <label class="option"><input type="checkbox" name="need" value={n.disciplines.join('|')} /><span>{n.label}</span></label>
          ))}
        </div>
        <p class="step-error" data-step-error hidden>Choose at least one thing you’d like help with.</p>
      </fieldset>

      <fieldset class="step" data-step="2" hidden>
        <legend class="step-title" tabindex="-1">Does any of this apply to you?</legend>
        <p class="step-hint">Choose any that fit, or skip this one.</p>
        <div class="options">
          {SPECIALISMS.map((s) => (
            <label class="option"><input type="checkbox" name="specialism" value={s} /><span>{s}</span></label>
          ))}
        </div>
      </fieldset>

      <fieldset class="step" data-step="3" hidden>
        <legend class="step-title" tabindex="-1">Where are you?</legend>
        <p class="step-hint">Members train people in person near them, and anywhere on video.</p>
        <select name="city" class="select" aria-label="Nearest city">
          <option value="">Somewhere else, or video is fine</option>
          {cities.map((c) => <option value={c}>{c}</option>)}
        </select>
      </fieldset>

      <fieldset class="step" data-step="4" hidden>
        <legend class="step-title" tabindex="-1">Would you like to work with someone of a particular gender?</legend>
        <div class="options">
          {GENDERS.map(([value, label]) => (
            <label class="option"><input type="radio" name="gender" value={value} checked={value === 'any'} /><span>{value === 'any' ? 'No preference' : label}</span></label>
          ))}
        </div>
      </fieldset>

      <div class="step step--results" data-step="5" hidden>
        <h2 class="step-title" tabindex="-1">Your suggestions</h2>

        <div class="group" data-group="coach">
          <h3 class="group-title">A coach to start with</h3>
          <p class="group-intro">Your coach is the person you talk to every week. They write your programme with you and bring in specialists when you need them. Profiles open in a new tab.</p>
          <div class="picks" data-picks></div>
          <p class="none" data-none hidden>No coaches match all of that at the moment. Go back and try fewer answers, or carry on and Fledg will suggest someone.</p>
        </div>

        <div class="group" data-group="specialist">
          <h3 class="group-title">Specialists who could help too</h3>
          <p class="group-intro">Your coach can bring any of them in. You pay each member directly, and you’ll know the cost before you agree.</p>
          <div class="picks" data-picks></div>
          <p class="none" data-none hidden>No specialists match that at the moment. Your coach can still suggest someone.</p>
        </div>

        <fieldset class="choose">
          <legend>Who would you like to start with?</legend>
          <div class="options" data-coach-options></div>
        </fieldset>
      </div>

      <div class="step" data-step="6" hidden>
        <h2 class="step-title" tabindex="-1">Your details</h2>
        <p class="step-hint" data-details-intro></p>
        <div class="fields">
          <label class="field"><span>Your name</span><input name="name" autocomplete="name" maxlength="120" /></label>
          <label class="field"><span>Email</span><input type="email" name="email" autocomplete="email" maxlength="200" /></label>
          <label class="field"><span>Phone <em>optional</em></span><input type="tel" name="phone" autocomplete="tel" maxlength="40" /></label>
          <label class="field field--wide"><span>Anything you’d like them to know? <em>optional</em></span><textarea name="note" rows="4" maxlength="2000"></textarea></label>
          <div class="trap" aria-hidden="true"><label>Leave this empty <input name="website" tabindex="-1" autocomplete="off" /></label></div>
        </div>
        <p class="step-error" data-step-error role="alert" hidden></p>
        <p class="small">Your details go by email to the coach you choose and to Fledg, and nowhere else. Nothing is stored on this website.</p>
      </div>

      <div class="step-nav">
        <button type="button" class="back" data-back hidden>Back</button>
        <button type="submit" class="btn btn--primary next" data-next>Next</button>
      </div>
    </form>

    <div class="done" data-done tabindex="-1" hidden>
      <h2 class="step-title" data-done-title></h2>
      <p data-done-text></p>
      <p data-done-booking hidden><a class="btn btn--secondary" data-done-booking-link>Book an intro call now</a></p>
      <p class="ph-note" data-done-preview hidden></p>
      <p><button type="button" class="back" data-again>Start again</button></p>
    </div>

    <noscript><p class="noscript">This form needs JavaScript. You can still <a href={links.members}>browse and filter every member</a>, or email <a href={links.email}>hello@fledg.org</a>.</p></noscript>

    <div class="pool" data-pool hidden>
      {members.map((m) => <MemberCard member={m} />)}
    </div>
  </section>
</BaseLayout>

<script>
  type Card = {
    el: HTMLElement;
    id: string;
    name: string;
    city: string;
    role: string;
    discipline: string;
    specialisms: string[];
    gender: string;
    taking: boolean;
    booking?: string;
  };

  const form = document.querySelector<HTMLFormElement>('[data-wizard]');
  const done = document.querySelector<HTMLElement>('[data-done]');
  if (form && done) {
    const total = Number(form.dataset.total);
    const cards: Card[] = [...document.querySelectorAll<HTMLElement>('[data-pool] [data-member-card]')].map((el) => ({
      el,
      id: el.dataset.id!,
      name: el.dataset.name!,
      city: el.dataset.city!,
      role: el.dataset.role!,
      discipline: el.dataset.discipline!,
      specialisms: el.dataset.specialisms!.split('|'),
      gender: el.dataset.gender!,
      taking: el.dataset.taking === 'true',
      booking: el.dataset.booking,
    }));
    const steps = [...form.querySelectorAll<HTMLElement>('[data-step]')];
    const stepCount = form.querySelector<HTMLElement>('[data-step-count]')!;
    const progress = form.querySelector<HTMLElement>('[data-progress]')!;
    const back = form.querySelector<HTMLButtonElement>('[data-back]')!;
    const next = form.querySelector<HTMLButtonElement>('[data-next]')!;
    const coachOptions = form.querySelector<HTMLElement>('[data-coach-options]')!;
    const first = (name: string) => name.trim().split(/\s+/)[0];
    const checked = (name: string) => [...form.querySelectorAll<HTMLInputElement>(`input[name=${name}]:checked`)];
    const labelOf = (input: HTMLInputElement) => input.nextElementSibling!.textContent!.trim();

    let current = 1;
    let suggested: Card[] = [];
    // The answers the suggestions were last built from, so going back and
    // forward rebuilds them only when something changed (keeping the coach chosen).
    let builtFor = '';
    const answersKey = () =>
      JSON.stringify([checked('need').map((i) => i.value), checked('specialism').map((i) => i.value),
        form.querySelector<HTMLSelectElement>('select[name=city]')!.value, checked('gender')[0]?.value]);

    // Matching: discipline counts most, then shared specialisms, then the same city.
    // Only members taking new clients are suggested.
    const suggest = (role: string, disciplines: Set<string>, specialisms: string[], city: string, gender: string) =>
      cards
        .filter((c) => c.role === role && c.taking)
        .filter((c) => gender === 'any' || c.gender === gender)
        .map((c) => {
          const discipline = disciplines.has(c.discipline);
          const shared = c.specialisms.filter((s) => specialisms.includes(s));
          const local = city !== '' && c.city === city;
          const score = (discipline ? 3 : 0) + shared.length + (local ? 1 : 0);
          const why = [discipline && c.discipline, shared.length > 0 && `Works with ${shared.join(', ').toLowerCase()}`, local && `In ${c.city}`];
          return { c, score, why: why.filter(Boolean).join(' · ') };
        })
        .filter((r) => r.score > 0)
        .sort((a, b) => b.score - a.score || a.c.name.localeCompare(b.c.name))
        .slice(0, 3);

    const show = (group: string, picks: ReturnType<typeof suggest>) => {
      const box = form.querySelector<HTMLElement>(`[data-group="${group}"]`)!;
      const list = box.querySelector<HTMLElement>('[data-picks]')!;
      list.replaceChildren(
        ...picks.map(({ c, why }) => {
          const wrap = document.createElement('div');
          wrap.className = 'pick';
          const reason = document.createElement('p');
          reason.className = 'why';
          reason.textContent = why;
          // Profiles open in a new tab so the answers here aren't lost.
          const card = c.el.cloneNode(true) as HTMLAnchorElement;
          card.target = '_blank';
          card.rel = 'noopener';
          wrap.append(reason, card);
          return wrap;
        }),
      );
      list.hidden = picks.length === 0;
      box.querySelector<HTMLElement>('[data-none]')!.hidden = picks.length > 0;
    };

    const buildSuggestions = () => {
      const disciplines = new Set(checked('need').flatMap((i) => i.value.split('|')));
      const specialisms = checked('specialism').map((i) => i.value);
      const city = form.querySelector<HTMLSelectElement>('select[name=city]')!.value;
      const gender = checked('gender')[0]?.value ?? 'any';
      const coaches = suggest('coach', disciplines, specialisms, city, gender);
      const specialists = suggest('specialist', disciplines, specialisms, city, gender);
      show('coach', coaches);
      show('specialist', specialists);
      suggested = [...coaches, ...specialists].map((r) => r.c);

      const choices = [...coaches.map(({ c }) => ({ value: c.id, label: c.name })), { value: '', label: 'I’m not sure yet' }];
      coachOptions.replaceChildren(
        ...choices.map((choice, i) => {
          const label = document.createElement('label');
          label.className = 'option';
          const input = Object.assign(document.createElement('input'), { type: 'radio', name: 'coach', value: choice.value, checked: i === 0 });
          const span = document.createElement('span');
          span.textContent = choice.label;
          label.append(input, span);
          return label;
        }),
      );
    };

    const chosenCoach = () => cards.find((c) => c.id === (checked('coach')[0]?.value ?? ''));

    const nextLabel = () => {
      if (current === 2) return checked('specialism').length ? 'Next' : 'Skip';
      if (current === 4) return 'Show my suggestions';
      if (current === 5) {
        const coach = chosenCoach();
        return coach ? `Continue with ${first(coach.name)}` : 'Continue';
      }
      if (current === total) return 'Sign up';
      return 'Next';
    };

    const stepError = (message?: string) => {
      const box = steps[current - 1].querySelector<HTMLElement>('[data-step-error]');
      if (!box) return;
      if (message !== undefined) box.textContent = message;
      box.hidden = message === undefined;
    };

    const goTo = (step: number, { push = true } = {}) => {
      current = step;
      if (step === 5 && answersKey() !== builtFor) {
        buildSuggestions();
        builtFor = answersKey();
      }
      steps.forEach((s) => (s.hidden = Number(s.dataset.step) !== step));
      stepCount.textContent = `Step ${step} of ${total}`;
      progress.style.width = `${(step / total) * 100}%`;
      back.hidden = step === 1;
      next.textContent = nextLabel();
      if (step === total) {
        const coach = chosenCoach();
        form.querySelector('[data-details-intro]')!.textContent = coach
          ? `We’ll send your answers to ${first(coach.name)} and to Fledg, so ${first(coach.name)} can get in touch about a free intro call.`
          : 'We’ll send your answers to Fledg, and someone will reply with a coach who’d suit you.';
      }
      if (push) history.pushState({ step }, '');
      // Bring the top of the form into view if the last step left it scrolled away.
      if (form.getBoundingClientRect().top < 80) form.scrollIntoView({ block: 'start' });
      steps[step - 1].querySelector<HTMLElement>('.step-title')!.focus({ preventScroll: true });
    };

    const send = async () => {
      const value = (name: string) => form.querySelector<HTMLInputElement | HTMLTextAreaElement>(`[name=${name}]`)!.value;
      const email = form.querySelector<HTMLInputElement>('input[name=email]')!;
      if (!value('name').trim() || !value('email').trim() || !email.checkValidity()) {
        stepError('Please add your name and a working email address.');
        form.querySelector<HTMLInputElement>(value('name').trim() ? 'input[name=email]' : 'input[name=name]')!.focus();
        return;
      }
      const coach = chosenCoach();
      const gender = checked('gender')[0];
      const payload = {
        name: value('name'),
        email: value('email'),
        phone: value('phone'),
        note: value('note'),
        coach: coach?.id ?? '',
        answers: {
          needs: checked('need').map(labelOf),
          specialisms: checked('specialism').map((i) => i.value),
          city: form.querySelector<HTMLSelectElement>('select[name=city]')!.value,
          gender: gender && gender.value !== 'any' ? labelOf(gender) : '',
        },
        suggested: suggested.map((c) => c.id),
        website: value('website'),
      };

      next.disabled = true;
      next.textContent = 'Sending…';
      let response: Response | undefined;
      try {
        response = await fetch('/api/sign-up', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
      } catch {
        // Network failure: handled below.
      }
      next.disabled = false;
      next.textContent = nextLabel();
      const result = response ? await response.json().catch(() => ({})) : {};

      if (!response?.ok) {
        const box = steps[current - 1].querySelector<HTMLElement>('[data-step-error]')!;
        box.replaceChildren(response?.status === 400 ? 'Please check your name and email address. ' : 'Sorry, that didn’t send. ');
        box.append('Or email ', Object.assign(document.createElement('a'), { href: 'mailto:hello@fledg.org', textContent: 'hello@fledg.org' }), ' and we’ll help.');
        box.hidden = false;
        return;
      }

      done.querySelector('[data-done-title]')!.textContent = `Thanks, ${first(payload.name)}.`;
      done.querySelector('[data-done-text]')!.textContent = coach
        ? `We’ve sent your answers to ${first(coach.name)} and to Fledg. ${first(coach.name)} will be in touch about a free intro call.`
        : 'We’ve sent your answers to Fledg. Someone will reply with a coach who’d suit you.';
      const booking = done.querySelector<HTMLElement>('[data-done-booking]')!;
      booking.hidden = !coach?.booking;
      if (coach?.booking) booking.querySelector('a')!.href = coach.booking;
      const preview = done.querySelector<HTMLElement>('[data-done-preview]')!;
      preview.hidden = !result.dryRun;
      if (result.dryRun) {
        preview.textContent = `Preview: no email was sent. It would have gone to ${result.to.join(' and ')}${coach && !result.coachHasEmail ? ` (${coach.name} has no email address on file yet)` : ''}.`;
      }
      form.hidden = true;
      done.hidden = false;
      done.focus();
    };

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      stepError();
      if (current === 1 && !checked('need').length) {
        stepError('Choose at least one thing you’d like help with.');
        return;
      }
      if (current === total) {
        send();
        return;
      }
      goTo(current + 1);
    });

    back.addEventListener('click', () => history.back());
    // The browser's back button steps back through the form too.
    window.addEventListener('popstate', (event) => {
      if (!form.hidden) goTo(event.state?.step ?? 1, { push: false });
    });
    form.addEventListener('change', () => {
      next.textContent = nextLabel();
      if (current === 1 && checked('need').length) stepError();
    });
    form.addEventListener('input', () => {
      if (current === total) stepError();
    });

    done.querySelector('[data-again]')!.addEventListener('click', () => {
      form.reset();
      form.hidden = false;
      done.hidden = true;
      goTo(1);
    });

    history.replaceState({ step: 1 }, '');
  }
</script>

<style>
  .intro {
    padding-block: clamp(28px, 5vw, 72px) clamp(24px, 3vw, 40px);
    display: flex;
    flex-direction: column;
    gap: clamp(12px, 1.6vw, 20px);
  }
  .intro-h1 {
    max-width: 820px;
    font-size: clamp(34px, 4.2vw, 60px);
  }
  .intro-lead { max-width: 620px; }

  .wizard-wrap { padding-bottom: var(--section-pad); }
  .wizard, .done {
    max-width: 880px;
    scroll-margin-top: calc(var(--header-h) + 24px);
  }
  .wizard[hidden], .done[hidden] { display: none; }

  .progress-row {
    display: flex;
    align-items: center;
    gap: 16px;
    padding-bottom: 28px;
    border-bottom: 1px solid var(--rule);
  }
  .step-count {
    flex: none;
    font-size: 13px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .progress {
    flex: 1;
    height: 4px;
    border-radius: 2px;
    background: var(--rule);
    overflow: hidden;
  }
  .progress span {
    display: block;
    height: 100%;
    border-radius: 2px;
    background: var(--teal);
    transition: width 0.3s ease;
  }

  .step {
    margin: 0;
    padding: 36px 0 0;
    border: 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .step[hidden] { display: none; }
  .step-title {
    float: left;
    width: 100%;
    margin: 0 0 4px;
    padding: 0;
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(30px, 3.2vw, 44px);
    line-height: 1.1;
    letter-spacing: -0.018em;
    text-wrap: balance;
    scroll-margin-top: calc(var(--header-h) + 24px);
  }
  .step-title:focus { outline: none; }
  .step-hint { margin: 0; font-size: 15px; line-height: 1.5; color: var(--slate); }
  .step-error { margin: 0; font-size: 15px; font-weight: 500; color: var(--leave-red); }
  .step-error[hidden] { display: none; }

  .options {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    padding-top: 6px;
  }
  /* :global because the coach choices are built by the script. */
  .options :global(.option) { position: relative; cursor: pointer; }
  .options :global(.option input) {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
  }
  .options :global(.option span) {
    display: inline-flex;
    align-items: center;
    height: 46px;
    padding: 0 18px;
    border-radius: 999px;
    border: 1px solid var(--rule);
    background: transparent;
    color: var(--ink);
    font-size: 16px;
    transition: background-color var(--ease), border-color var(--ease), color var(--ease);
  }
  .options :global(.option:hover span) { border-color: var(--ink); }
  .options :global(.option input:checked + span) {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }
  .options :global(.option input:focus-visible + span),
  .select:focus-visible {
    outline: 2px solid var(--teal);
    outline-offset: 2px;
  }
  .select {
    align-self: flex-start;
    min-width: min(100%, 360px);
    height: 50px;
    margin-top: 6px;
    padding: 0 14px;
    border: 1px solid var(--rule-strong);
    border-radius: 8px;
    background: var(--white);
    color: var(--ink);
    font: inherit;
    font-size: 16px;
  }

  .step-nav {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 36px;
    padding-top: 24px;
    border-top: 1px solid var(--rule);
  }
  .step-nav .next {
    margin-left: auto;
    border: 0;
    cursor: pointer;
    font-family: inherit;
  }
  .step-nav .next:disabled { opacity: 0.6; cursor: default; }
  .back {
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--teal);
    font-size: 16px;
    text-decoration: underline;
    text-underline-offset: 0.18em;
    cursor: pointer;
  }
  .back:hover { color: var(--ink); }
  .back[hidden] { display: none; }

  /* Step 5: suggestions */
  .step--results { gap: clamp(32px, 4vw, 48px); }
  .group { display: flex; flex-direction: column; gap: 10px; }
  .group-title {
    margin: 0;
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(24px, 2vw, 28px);
    line-height: 1.15;
    letter-spacing: -0.012em;
  }
  .group-intro {
    margin: 0 0 12px;
    max-width: 640px;
    font-size: 15px;
    line-height: 1.55;
    color: var(--slate);
  }
  .picks {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 250px), 1fr));
    gap: 40px 24px;
  }
  .picks[hidden], .none[hidden] { display: none; }
  .picks :global(.pick) { display: flex; flex-direction: column; gap: 10px; }
  .picks :global(.why) {
    margin: 0;
    padding: 6px 10px;
    border-radius: 6px;
    background: var(--teal-pale);
    color: var(--teal-ink);
    font-size: 13px;
    font-weight: 500;
    line-height: 1.4;
  }
  .none { margin: 0; font-size: 15px; color: var(--slate); }
  .choose {
    margin: 0;
    padding: 24px 0 0;
    border: 0;
    border-top: 1px solid var(--ink);
    min-width: 0;
  }
  .choose legend {
    float: left;
    width: 100%;
    padding: 0;
    margin-bottom: 8px;
    font-family: var(--serif);
    font-size: clamp(24px, 2vw, 28px);
    line-height: 1.2;
  }

  /* Step 6: details */
  .fields {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 18px 24px;
    padding-top: 6px;
  }
  .field { display: flex; flex-direction: column; gap: 6px; font-size: 14px; font-weight: 500; }
  .field--wide { grid-column: 1 / -1; }
  .field em { font-style: normal; font-weight: 400; color: var(--slate); }
  .field input, .field textarea {
    width: 100%;
    padding: 12px 14px;
    border: 1px solid var(--rule-strong);
    border-radius: 8px;
    background: var(--white);
    color: var(--ink);
    font: inherit;
